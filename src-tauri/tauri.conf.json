{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "糕糕桌宠",
  "version": "0.1.0-beta.2",
  "identifier": "com.laozhongmihari.gaogao",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "糕糕",
        "url": "index.html",
        "width": 192,
        "height": 208,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "focus": false
      },
      {
        "label": "bubble",
        "title": "糕糕气泡",
        "url": "index.html",
        "width": 288,
        "height": 112,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "糕糕设置",
        "url": "index.html",
        "width": 560,
        "height": 680,
        "minWidth": 480,
        "minHeight": 560,
        "resizable": true,
        "maximizable": false,
        "visible": false
      }
    ],
    "security": {
      "capabilities": ["desktop"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "devCsp": "default-src 'self' http://localhost:1420; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' http://localhost:1420 asset: http://asset.localhost data: blob:; style-src 'self' http://localhost:1420 'unsafe-inline'; font-src 'self' data:; script-src 'self' http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
